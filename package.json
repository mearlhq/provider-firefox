{
  "name": "@mearl/provider-firefox",
  "version": "0.1.0",
  "description": "Attach Mearl to a running Firefox with WebDriver BiDi",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mearlhq/provider-firefox.git"
  },
  "homepage": "https://github.com/mearlhq/provider-firefox#readme",
  "bugs": {
    "url": "https://github.com/mearlhq/provider-firefox/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": ["dist", "README.md", "README.en.md"],
  "engines": {
    "node": ">=20.18.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@mearl/browser-core": "3.1.0",
    "@mearl/plugin-tracking": "3.1.0",
    "@mearl/provider": "3.1.0",
    "tough-cookie": "^6.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3",
    "vitest": "4.1.12"
  },
  "mearl": {
    "provider": {
      "providerId": "firefox",
      "name": "Firefox",
      "protocolVersion": 3,
      "entry": "./dist/runtime.js",
      "browserType": {
        "name": "Firefox",
        "openOperation": "attach",
        "help": ["Start Firefox with --remote-debugging-port and pass that port in providerOptions.port."],
        "inputSchema": {
          "type": "object",
          "required": ["port"],
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "number",
              "integer": true,
              "minimum": 1,
              "maximum": 65535,
              "title": "Firefox BiDi port",
              "description": "The local port printed by Firefox as WebDriver BiDi listening."
            }
          }
        }
      }
    }
  }
}
